{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interior Design Spec Assistant product record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "room", "category", "product_name", "quantity", "currency", "attributes", "sources", "approval_status"],
  "properties": {
    "item_id": {"type": "string", "pattern": "^[FLM]-[0-9]{3,}$"},
    "room": {"type": "string", "minLength": 1},
    "category": {"enum": ["furniture", "lighting", "material"]},
    "product_name": {"type": ["string", "null"]},
    "quantity": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "attributes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/evidencedValue"}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["source_id", "type", "reference"], "properties": {"source_id": {"type": "string"}, "type": {"enum": ["client_text", "url", "pdf", "image", "manufacturer_sheet"]}, "reference": {"type": "string"}, "accessed_on": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "approval_status": {"enum": ["Draft", "Needs Verification", "Ready for Review", "Approved"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"evidencedValue": {"type": "object", "required": ["value", "evidence", "source_ids"], "additionalProperties": false, "properties": {"value": {"type": ["string", "number", "null"]}, "evidence": {"enum": ["VERIFIED", "CLIENT-PROVIDED", "MISSING", "CONFLICT"]}, "source_ids": {"type": "array", "items": {"type": "string"}}, "note": {"type": "string"}}}}
}
